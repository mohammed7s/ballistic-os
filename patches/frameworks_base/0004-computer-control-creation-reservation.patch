+    @Test
+    public void construction_allowsConcurrentDisplayQuery() throws Exception {
+        when(mVirtualDeviceFactory.createVirtualDevice(any(), any(), any())).thenAnswer(invocation -> {
+            runOnOtherThread(() -> mProcessor.isComputerControlDisplay(VIRTUAL_DISPLAY_ID));
+            return mVirtualDevice;
+        });
+        mProcessor.processNewSessionRequest(
+                mAppThread, ATTRIBUTION_SOURCE, PARAMS, mComputerControlSessionCallback);
+        verify(mComputerControlSessionCallback, timeout(CALLBACK_TIMEOUT_MS))
+                .onSessionCreated(anyInt(), any());
+    }
+
+    @Test
+    public void withdrawalDuringConstruction_discardsSessionWithoutPublishing() throws Exception {
+        when(mVirtualDeviceFactory.createVirtualDevice(any(), any(), any())).thenAnswer(invocation -> {
+            runOnOtherThread(() -> mProcessor.setPackageTargetableForAutomationByUser(
+                    TARGET_PACKAGE, CALLING_USER_ID, false));
+            return mVirtualDevice;
+        });
+        // Leave the mocked allowlist recheck true: the generation must still invalidate creation.
+        mProcessor.processNewSessionRequest(
+                mAppThread, ATTRIBUTION_SOURCE, PARAMS, mComputerControlSessionCallback);
+        verify(mComputerControlSessionCallback, timeout(CALLBACK_TIMEOUT_MS))
+                .onSessionCreationFailed(ComputerControlSession.ERROR_PERMISSION_DENIED);
+        verify(mVirtualDevice, timeout(CALLBACK_TIMEOUT_MS)).close();
+        verify(mComputerControlSessionCallback, never()).onSessionCreated(anyInt(), any());
+        assertFalse(mProcessor.isComputerControlSession(DEVICE_ID));
+    }
+
+    @Test
