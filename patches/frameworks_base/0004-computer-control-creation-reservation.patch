+    private void updateAuthorization(@NonNull Runnable update,
+            @Nullable Predicate<ComputerControlSessionImpl> shouldClose) {
         synchronized (mSessions) {
-            mAllowlistController.setPackageTargetableForAutomationByUser(packageName, userId,
-                    targetable);
-            if (targetable) {
-                return;
+            ++mAuthorizationGeneration;
+            ++mAuthorizationUpdates;
+        }
+        try {
+            update.run();
+        } finally {
+            final List<ComputerControlSessionImpl> sessions;
+            synchronized (mSessions) {
+                ++mAuthorizationGeneration;
+                --mAuthorizationUpdates;
+                sessions = new ArrayList<>(mSessions);
             }
-
-            for (int i = mSessions.size() - 1; i >= 0; i--) {
-                ComputerControlSessionImpl session = mSessions.valueAt(i);
-                if (session.getOwnerUserId() == userId
-                        && session.isAutomatingPackage(packageName)) {
-                    session.close(CLOSE_REASON_USER_INITIATED);
+            if (shouldClose != null) {
+                for (ComputerControlSessionImpl session : sessions) {
+                    if (shouldClose.test(session)) {
+                        session.close(CLOSE_REASON_USER_INITIATED);
+                    }
                 }
             }
         }
     }
 
+    private List<ComputerControlSessionImpl> snapshotSessions() {
+        synchronized (mSessions) {
+            return new ArrayList<>(mSessions);
+        }
+    }
+
+    private boolean hasSessionCapacity() {
+        synchronized (mSessions) {
+            return mSessions.size() + mPendingCreations.size() < MAXIMUM_CONCURRENT_SESSIONS;
+        }
+    }
