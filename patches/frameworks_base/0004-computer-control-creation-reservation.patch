@@ -490,61 +513,86 @@ public final class ComputerControlSessionProcessor {
 
     private void createSession(@NonNull ComputerControlSessionRequest request,
             @NonNull List<String> approvedTargets) {
+        final PendingCreation pending;
+        final int reservationError;
         synchronized (mSessions) {
-            if (!mAllowlistController.isRequestStillAllowed(request, approvedTargets)) {
-                dispatchSessionCreationFailed(request, ComputerControlSession.ERROR_PERMISSION_DENIED);
-                return;
+            if (mAuthorizationUpdates != 0) {
+                reservationError = ComputerControlSession.ERROR_PERMISSION_DENIED;
+                pending = null;
+            } else if (mSessions.size() + mPendingCreations.size() >= MAXIMUM_CONCURRENT_SESSIONS) {
+                reservationError = ComputerControlSession.ERROR_SESSION_LIMIT_REACHED;
+                pending = null;
+            } else {
+                reservationError = 0;
+                pending = new PendingCreation(mAuthorizationGeneration);
+                mPendingCreations.add(pending);
             }
-            createSessionLocked(request);
         }
-    }
-
-    @GuardedBy("mSessions")
-    private void createSessionLocked(@NonNull ComputerControlSessionRequest request) {
-        if (!request.appToken().pingBinder()) {
-            Slog.w(TAG, "Binder is dead for ComputerControlSession " + request.name()
-                    + ", aborting session creation");
-            // Don't bother creating the session if the requester is not around anymore.
+        if (pending == null) {
+            dispatchSessionCreationFailed(request, reservationError);
             return;
         }
 
-        synchronized (mSessions) {
-            if (!checkSessionCreationPreconditionsLocked(request)) {
-                return;
-            }
-        }
-
-        Slog.d(TAG, "Creating ComputerControlSession " + request.name());
-        final ComputerControlSessionImpl session;
+        ComputerControlSessionImpl session = null;
+        boolean published = false;
         final long token = Binder.clearCallingIdentity();
         try {
+            if (!request.appToken().pingBinder() || !checkSessionCreationPreconditions(request)) {
+                return;
+            }
+            if (!mAllowlistController.isRequestStillAllowed(request, approvedTargets)) {
+                dispatchSessionCreationFailed(request, ComputerControlSession.ERROR_PERMISSION_DENIED);
+                return;
+            }
             session = new ComputerControlSessionImpl(
                     mContext, mAllowlistController, request, mVirtualDeviceFactory,
                     (closedSession) -> {
                         synchronized (mSessions) {
+                            pending.closed = true;
                             mSessions.remove(closedSession);
                         }
                     }, mReferenceDisplayAddress);
+
+            // Construction calls into WindowManager and other services. Never hold mSessions
+            // across it, policy queries, session closure, or callbacks into clients.
+            if (!checkSessionCreationPreconditions(request)) {
+                return;
+            }
+            final boolean authorized = request.appToken().pingBinder()
+                    && mAllowlistController.isRequestStillAllowed(request, approvedTargets);
             synchronized (mSessions) {
-                mSessions.add(session);
+                if (authorized && !pending.closed && mAuthorizationUpdates == 0
+                        && pending.generation == mAuthorizationGeneration) {
+                    mPendingCreations.remove(pending);
+                    mSessions.add(session);
+                    published = true;
+                }
+            }
+            if (!published) {
+                dispatchSessionCreationFailed(request, ComputerControlSession.ERROR_PERMISSION_DENIED);
+                return;
+            }
+            try {
+                request.callback().onSessionCreated(session.getVirtualDisplayId(), session);
+            } catch (RemoteException e) {
+                Slog.e(TAG, "Failed to notify ComputerControlSession " + request.name()
+                        + " about session creation success", e);
+                session.close(CLOSE_REASON_USER_INITIATED);
             }
         } catch (RuntimeException e) {
-            // The virtual device for a ComputerControlSession lives in the system server.
-            // The app requesting the session may die anytime, invalidating the device.
-            // If this happens during the initialization of the session it will produce
-            // an Exception when trying to access the virtual device.
             Slog.e(TAG, "Exception creating ComputerControlSession " + request.name(), e);
             dispatchSessionCreationFailed(request, ComputerControlSession.ERROR_UNKNOWN);
-            return;
         } finally {
-            Binder.restoreCallingIdentity(token);
-        }
-
-        try {
-            request.callback().onSessionCreated(session.getVirtualDisplayId(), session);
-        } catch (RemoteException e) {
-            Slog.e(TAG, "Failed to notify ComputerControlSession " + request.name()
-                    + " about session creation success");
+            synchronized (mSessions) {
+                mPendingCreations.remove(pending);
+            }
+            try {
+                if (session != null && !published) {
+                    session.close(CLOSE_REASON_USER_INITIATED);
+                }
+            } finally {
+                Binder.restoreCallingIdentity(token);
+            }
         }
     }
 
