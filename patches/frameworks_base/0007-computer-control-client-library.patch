From 8ae4e38b3c42a6b903138abd1f0d4c7be14d8575 Mon Sep 17 00:00:00 2001
From: Mohammed <91819504+mohammed7s@users.noreply.github.com>
Date: Sat, 21 Nov 2026 14:07:26 +0300
Subject: [PATCH] computercontrol: install the shared wrapper and publish
 compile-only stubs

Require the existing system_ext library from the consent app and expose the generated public API source as a compile-only Java library. Ordinary clients load the installed wrapper rather than embedding platform API calls.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 libs/computercontrol/Android.bp          | 10 ++++++++++
 packages/VirtualDeviceManager/Android.bp |  1 +
 2 files changed, 11 insertions(+)

diff --git a/libs/computercontrol/Android.bp b/libs/computercontrol/Android.bp
index a6f12f251..63b6f0ca7 100644
--- a/libs/computercontrol/Android.bp
+++ b/libs/computercontrol/Android.bp
@@ -86,3 +86,13 @@ genrule {
         "last-released-api.txt",
     ],
 }
+
+// Compile-only public API jar for independently signed clients. Never package implementation
+// classes in an APK: they must execute from the installed system_ext shared library.
+java_library {
+    name: "computercontrol.extension.stubs.public",
+    srcs: [":computercontrol.extension.stubs"],
+    sdk_version: "current",
+    libs: ["androidx.annotation_annotation", "stub-annotations"],
+    installable: false,
+}
diff --git a/packages/VirtualDeviceManager/Android.bp b/packages/VirtualDeviceManager/Android.bp
index cdcdf7882..8ef12c62e 100644
--- a/packages/VirtualDeviceManager/Android.bp
+++ b/packages/VirtualDeviceManager/Android.bp
@@ -7,6 +7,7 @@ android_app {
     name: "VirtualDeviceManager",
     defaults: ["platform_app_defaults"],
     certificate: "platform",
+    required: ["com.android.extensions.computercontrol"],
     srcs: ["src/**/*.java"],
     static_libs: [
         "SettingsLibSettingsTheme",
-- 
2.53.0

