+    private static void validateSessionParams(@NonNull ComputerControlSessionParams params) {
+        if (params.getTargetComputerControlVersion() < MIN_COMPUTER_CONTROL_VERSION_FOR_ANDROID_17) {
+            throw new IllegalArgumentException("Computer Control version 5 or later is required");
+        }
+        if (params.getName() == null || params.getName().isEmpty()) {
+            throw new IllegalArgumentException("Session name is required");
+        }
+        final ComputerControlSessionParams.NotificationParams notification =
+                params.getNotificationParams();
+        if (notification == null || notification.getNotification() == null) {
+            throw new IllegalArgumentException("A session notification is required");
+        }
+        // Parcelable constructors do not run Builder validation, including nested objects.
+        new ComputerControlSessionParams.NotificationParams.Builder(
+                notification.getNotification(), notification.getNotificationId()).build();
+        for (String target : params.getTargetPackageNames()) {
+            if (target == null || target.isEmpty()) {
+                throw new IllegalArgumentException("Target package names must not be empty");
+            }
+        }
+        // Reuse the API's constraints, notably attribution and the six-target limit.
+        new ComputerControlSessionParams.Builder()
+                .setName(params.getName())
+                .setTargetComputerControlVersion(params.getTargetComputerControlVersion())
+                .setTargetPackageNames(params.getTargetPackageNames())
+                .setPreviewIntent(params.getPreviewIntent())
+                .setAppInteractionAttribution(params.getAppInteractionAttribution())
+                .setCompanionDeviceId(params.getCompanionDeviceId())
+                .setNotificationParams(notification)
+                .build();
+    }
+
     private void validateRequest(@NonNull ComputerControlSessionRequest request) {
+        validateSessionParams(request.params());
         // TODO: b/445856399 - Support managed profiles.
         Binder.withCleanCallingIdentity(() -> {
             if (!isComputerControlAvailableForUser(request.ownerUserId())) {
