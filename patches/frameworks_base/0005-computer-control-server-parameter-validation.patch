+    private void assertInvalidParcel(ComputerControlSessionParams params) {
+        assertThrows(IllegalArgumentException.class, () -> mProcessor.processNewSessionRequest(
+                mAppThread, ATTRIBUTION_SOURCE, params, mComputerControlSessionCallback));
+        verify(mVirtualDeviceFactory, never()).createVirtualDevice(any(), any(), any());
+    }
+
+    private static ComputerControlSessionParams parcelledParams(
+            ComputerControlSessionParams.NotificationParams notification,
+            List<String> targets, AppInteractionAttribution attribution) {
+        Parcel parcel = Parcel.obtain();
+        try {
+            parcel.writeString8("crafted");
+            parcel.writeStringList(targets);
+            parcel.writeTypedObject(null, 0); // Preview intent
+            parcel.writeTypedObject(attribution, 0);
+            parcel.writeInt(MIN_COMPUTER_CONTROL_VERSION_FOR_ANDROID_17);
+            parcel.writeTypedObject(null, 0); // Companion device
+            parcel.writeTypedObject(notification, 0);
+            parcel.setDataPosition(0);
+            return ComputerControlSessionParams.CREATOR.createFromParcel(parcel);
+        } finally {
+            parcel.recycle();
+        }
+    }
+
+    private static ComputerControlSessionParams.NotificationParams parcelledNotification(
+            Notification notification) {
+        Parcel parcel = Parcel.obtain();
+        try {
+            parcel.writeTypedObject(notification, 0);
+            parcel.writeInt(NOTIFICATION_ID);
+            parcel.writeString8(NOTIFICATION_TAG);
+            parcel.setDataPosition(0);
+            return ComputerControlSessionParams.NotificationParams.CREATOR.createFromParcel(parcel);
+        } finally {
+            parcel.recycle();
+        }
+    }
