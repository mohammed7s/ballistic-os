+    private boolean isRequestStillAuthorized(@NonNull ComputerControlSessionRequest request,
+            @NonNull List<String> approvedTargets, boolean testAgent) {
+        if (!isComputerControlAvailableForUser(request.ownerUserId())
+                || !mAllowlistController.isRequestStillAllowed(request, approvedTargets, testAgent)) {
+            return false;
+        }
+        final int mode = mAppOpsManager.checkOpNoThrow(
+                AppOpsManager.OP_COMPUTER_CONTROL, request.attributionSource());
+        // MODE_DEFAULT needs fresh consent for every target. In particular, an old saved grant
+        // cannot override an AppOp reset or an explicit denial while a dialog was open.
+        return mode == AppOpsManager.MODE_ALLOWED
+                || (mode == AppOpsManager.MODE_DEFAULT
+                        && approvedTargets.containsAll(request.params().getTargetPackageNames()));
+    }
