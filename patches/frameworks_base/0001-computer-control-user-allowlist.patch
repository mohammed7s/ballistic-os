+package com.android.server.companion.virtual.computercontrol;
+
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+import android.content.pm.Signature;
+import android.content.pm.SigningDetails;
+import android.platform.test.annotations.Presubmit;
+
+import androidx.test.ext.junit.runners.AndroidJUnit4;
+
+import org.junit.After;
+import org.junit.Before;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+
+import java.io.File;
+import java.io.FileOutputStream;
+import java.io.IOException;
+
+@Presubmit
+@RunWith(AndroidJUnit4.class)
+public class ComputerControlUserAllowlistTest {
+
+    private static final int USER_ID = 0;
+    private static final int OTHER_USER_ID = 10;
+    private static final String AGENT = "com.example.agent";
+    private static final String TARGET = "com.example.target";
+
+    private final SigningDetails mSignedByA = signedBy(signature(1));
+    private final SigningDetails mSignedByB = signedBy(signature(2));
+
+    private File mFile;
+    private ComputerControlUserAllowlist mAllowlist;
+
+    @Before
+    public void setUp() throws IOException {
+        mFile = File.createTempFile("test_user_allowlist", ".xml");
+        mFile.delete();
+        mAllowlist = newAllowlist();
+    }
+
+    @After
+    public void tearDown() {
+        mFile.delete();
+    }
+
+    @Test
+    public void emptyByDefault() {
+        assertFalse(mAllowlist.isSessionOwner(USER_ID, AGENT, mSignedByA));
+        assertFalse(mAllowlist.isAutomatableApp(USER_ID, TARGET, mSignedByA));
+    }
+
+    @Test
+    public void addSessionOwner_matchesSameSignerAndUserOnly() {
+        mAllowlist.addSessionOwner(USER_ID, AGENT, mSignedByA);
+
+        assertTrue(mAllowlist.isSessionOwner(USER_ID, AGENT, mSignedByA));
+        assertFalse(mAllowlist.isSessionOwner(USER_ID, AGENT, mSignedByB));
+        assertFalse(mAllowlist.isSessionOwner(OTHER_USER_ID, AGENT, mSignedByA));
+        assertFalse(mAllowlist.isAutomatableApp(USER_ID, AGENT, mSignedByA));
+    }
+
+    @Test
+    public void addAutomatableApp_doesNotMakeSessionOwner() {
+        mAllowlist.addAutomatableApp(USER_ID, TARGET, mSignedByA);
+
+        assertTrue(mAllowlist.isAutomatableApp(USER_ID, TARGET, mSignedByA));
+        assertFalse(mAllowlist.isSessionOwner(USER_ID, TARGET, mSignedByA));
+    }
+
+    @Test
+    public void keyRotation_keepsEntry() throws Exception {
+        mAllowlist.addSessionOwner(USER_ID, AGENT, mSignedByA);
+        final SigningDetails rotated = new SigningDetails(new Signature[] {signature(2)},
+                SigningDetails.SignatureSchemeVersion.SIGNING_BLOCK_V3, null,
+                new Signature[] {signature(1), signature(2)});
+
+        assertTrue(mAllowlist.isSessionOwner(USER_ID, AGENT, rotated));
+    }
+
+    @Test
+    public void remove_dropsEntry() {
+        mAllowlist.addSessionOwner(USER_ID, AGENT, mSignedByA);
+        mAllowlist.addAutomatableApp(USER_ID, TARGET, mSignedByA);
+
+        mAllowlist.removeSessionOwner(USER_ID, AGENT);
+        mAllowlist.removeAutomatableApp(USER_ID, TARGET);
+
+        assertFalse(mAllowlist.isSessionOwner(USER_ID, AGENT, mSignedByA));
+        assertFalse(mAllowlist.isAutomatableApp(USER_ID, TARGET, mSignedByA));
+    }
+
+    @Test
+    public void onPackageRemoved_dropsEntriesForThatUserOnly() {
+        mAllowlist.addAutomatableApp(USER_ID, TARGET, mSignedByA);
+        mAllowlist.addAutomatableApp(OTHER_USER_ID, TARGET, mSignedByA);
+
+        mAllowlist.onPackageRemoved(USER_ID, TARGET);
+
+        assertFalse(mAllowlist.isAutomatableApp(USER_ID, TARGET, mSignedByA));
+        assertTrue(mAllowlist.isAutomatableApp(OTHER_USER_ID, TARGET, mSignedByA));
+    }
+
+    @Test
+    public void entriesArePersisted() {
+        mAllowlist.addSessionOwner(USER_ID, AGENT, mSignedByA);
+        mAllowlist.addAutomatableApp(OTHER_USER_ID, TARGET, mSignedByB);
+
+        final ComputerControlUserAllowlist reloaded = newAllowlist();
+
+        assertTrue(reloaded.isSessionOwner(USER_ID, AGENT, mSignedByA));
+        assertTrue(reloaded.isAutomatableApp(OTHER_USER_ID, TARGET, mSignedByB));
+        assertFalse(reloaded.isAutomatableApp(OTHER_USER_ID, TARGET, mSignedByA));
+    }
+
+    @Test
+    public void corruptFile_startsEmpty() throws IOException {
+        try (FileOutputStream fos = new FileOutputStream(mFile)) {
+            fos.write("corrupt data".getBytes());
+        }
+
+        final ComputerControlUserAllowlist reloaded = newAllowlist();
+
+        assertFalse(reloaded.isSessionOwner(USER_ID, AGENT, mSignedByA));
+    }
+
+    private ComputerControlUserAllowlist newAllowlist() {
+        final ComputerControlUserAllowlist allowlist =
+                new ComputerControlUserAllowlist(mFile, Runnable::run);
+        allowlist.load();
+        return allowlist;
+    }
+
+    private static Signature signature(int i) {
+        final byte[] signatureBytes = new byte[256];
+        signatureBytes[0] = (byte) i;
+        return new Signature(signatureBytes);
+    }
+
+    private static SigningDetails signedBy(Signature signature) {
+        return new SigningDetails(new Signature[] {signature},
+                SigningDetails.SignatureSchemeVersion.SIGNING_BLOCK_V3, null, null);
+    }
+}
