+/**
+ * Computer control allowlists that only the user can change.
+ *
+ * <p>These play the same role as the DeviceConfig session owner and automatable app allowlists
+ * in {@link ComputerControlAllowlistController}, for devices that do not receive DeviceConfig.
+ * They are empty by default and kept per user. Each entry is bound to the signing certificates
+ * the package had when the user allowed it, so a differently signed package with the same name
+ * does not inherit the entry; a key rotation that keeps the old certificate in the lineage does.
+ */
+final class ComputerControlUserAllowlist {
+    private static final String TAG = "ComputerControlUserAllowlist";
+
+    private static final String TAG_ROOT = "computer-control-user-allowlist";
+    private static final String TAG_USER = "user";
+    private static final String TAG_SESSION_OWNER = "session-owner";
+    private static final String TAG_AUTOMATABLE_APP = "automatable-app";
+    private static final String TAG_CERT = "cert";
+    private static final String ATTR_USER_ID = "id";
+    private static final String ATTR_PACKAGE = "package";
+    private static final String ATTR_SHA256 = "sha256";
+
+    private final AtomicFile mAtomicFile;
+    private final Executor mBackgroundExecutor;
+    private final Object mLock = new Object();
+    @GuardedBy("mLock")
+    private final PackageList mSessionOwners = new PackageList();
+    @GuardedBy("mLock")
+    private final PackageList mAutomatableApps = new PackageList();
+
+    ComputerControlUserAllowlist(@NonNull File file, @NonNull Executor backgroundExecutor) {
+        mAtomicFile = new AtomicFile(file);
+        mBackgroundExecutor = backgroundExecutor;
+    }
+
+    /** Returns whether the user allowed {@code packageName} to own computer control sessions. */
+    boolean isSessionOwner(@UserIdInt int userId, @NonNull String packageName,
+            @NonNull SigningDetails signingDetails) {
+        synchronized (mLock) {
+            return mSessionOwners.matches(userId, packageName, signingDetails);
+        }
+    }
+
+    /** Returns whether the user allowed {@code packageName} to be automated. */
+    boolean isAutomatableApp(@UserIdInt int userId, @NonNull String packageName,
+            @NonNull SigningDetails signingDetails) {
+        synchronized (mLock) {
+            return mAutomatableApps.matches(userId, packageName, signingDetails);
+        }
+    }
+
+    /** Allows {@code packageName} to own sessions, bound to its current certificates. */
+    void addSessionOwner(@UserIdInt int userId, @NonNull String packageName,
+            @NonNull SigningDetails signingDetails) {
+        synchronized (mLock) {
+            if (mSessionOwners.add(userId, packageName, signingDetails)) {
+                scheduleWriteLocked();
+            }
+        }
+    }
+
+    void removeSessionOwner(@UserIdInt int userId, @NonNull String packageName) {
+        synchronized (mLock) {
+            if (mSessionOwners.remove(userId, packageName)) {
+                scheduleWriteLocked();
+            }
+        }
+    }
+
+    /** Allows {@code packageName} to be automated, bound to its current certificates. */
+    void addAutomatableApp(@UserIdInt int userId, @NonNull String packageName,
+            @NonNull SigningDetails signingDetails) {
+        synchronized (mLock) {
+            if (mAutomatableApps.add(userId, packageName, signingDetails)) {
+                scheduleWriteLocked();
+            }
+        }
+    }
+
+    void removeAutomatableApp(@UserIdInt int userId, @NonNull String packageName) {
+        synchronized (mLock) {
+            if (mAutomatableApps.remove(userId, packageName)) {
+                scheduleWriteLocked();
+            }
+        }
+    }
+
+    /** Drops every entry for a package that was uninstalled from {@code userId}. */
+    void onPackageRemoved(@UserIdInt int userId, @NonNull String packageName) {
+        synchronized (mLock) {
+            final boolean changed = mSessionOwners.remove(userId, packageName)
+                    | mAutomatableApps.remove(userId, packageName);
+            if (changed) {
+                scheduleWriteLocked();
+            }
+        }
+    }
+
+    /** Reads the persisted lists. Entries are not consulted before this has run. */
+    void load() {
+        final PackageList sessionOwners = new PackageList();
+        final PackageList automatableApps = new PackageList();
+        if (mAtomicFile.exists()) {
+            try (FileInputStream stream = mAtomicFile.openRead()) {
+                final TypedXmlPullParser parser = Xml.resolvePullParser(stream);
+                int type;
+                while ((type = parser.next()) != XmlPullParser.END_DOCUMENT) {
+                    if (type == XmlPullParser.START_TAG && TAG_USER.equals(parser.getName())) {
+                        readUser(parser, sessionOwners, automatableApps);
+                    }
+                }
+            } catch (IOException | XmlPullParserException | RuntimeException e) {
+                // Fail closed: a corrupt file leaves both lists empty.
+                Slog.e(TAG, "Failed to read user allowlist, starting empty", e);
+                sessionOwners.clear();
+                automatableApps.clear();
+            }
+        }
+        synchronized (mLock) {
+            mSessionOwners.replaceWith(sessionOwners);
+            mAutomatableApps.replaceWith(automatableApps);
+        }
+    }
+
+    void dump(@NonNull PrintWriter fout, @NonNull String indent) {
+        synchronized (mLock) {
+            fout.println(indent + "User-approved session owners: " + mSessionOwners);
+            fout.println(indent + "User-approved automatable apps: " + mAutomatableApps);
+        }
+    }
+
+    private static void readUser(@NonNull TypedXmlPullParser parser,
+            @NonNull PackageList sessionOwners, @NonNull PackageList automatableApps)
+            throws IOException, XmlPullParserException {
+        final int userId = parser.getAttributeInt(null, ATTR_USER_ID);
+        final int userDepth = parser.getDepth();
+        int type;
+        while ((type = parser.next()) != XmlPullParser.END_DOCUMENT
+                && (type != XmlPullParser.END_TAG || parser.getDepth() > userDepth)) {
+            if (type != XmlPullParser.START_TAG) {
+                continue;
+            }
+            if (TAG_SESSION_OWNER.equals(parser.getName())) {
+                readPackage(parser, userId, sessionOwners);
+            } else if (TAG_AUTOMATABLE_APP.equals(parser.getName())) {
+                readPackage(parser, userId, automatableApps);
+            }
+        }
+    }
+
+    private static void readPackage(@NonNull TypedXmlPullParser parser, @UserIdInt int userId,
+            @NonNull PackageList list) throws IOException, XmlPullParserException {
+        final String packageName = parser.getAttributeValue(null, ATTR_PACKAGE);
+        final ArraySet<String> digests = new ArraySet<>();
+        final int packageDepth = parser.getDepth();
+        int type;
+        while ((type = parser.next()) != XmlPullParser.END_DOCUMENT
+                && (type != XmlPullParser.END_TAG || parser.getDepth() > packageDepth)) {
+            if (type == XmlPullParser.START_TAG && TAG_CERT.equals(parser.getName())) {
+                final String digest = parser.getAttributeValue(null, ATTR_SHA256);
+                if (digest != null) {
+                    digests.add(digest);
+                }
+            }
+        }
+        if (packageName != null && !digests.isEmpty()) {
+            list.put(userId, packageName, digests);
+        }
+    }
+
+    @GuardedBy("mLock")
+    private void scheduleWriteLocked() {
+        final PackageList sessionOwners = mSessionOwners.copy();
+        final PackageList automatableApps = mAutomatableApps.copy();
+        mBackgroundExecutor.execute(() -> write(sessionOwners, automatableApps));
+    }
+
+    private void write(@NonNull PackageList sessionOwners, @NonNull PackageList automatableApps) {
+        FileOutputStream stream = null;
+        try {
+            stream = mAtomicFile.startWrite();
+            final TypedXmlSerializer serializer = Xml.resolveSerializer(stream);
+            serializer.startDocument(null, true);
+            serializer.startTag(null, TAG_ROOT);
+            final ArraySet<Integer> userIds = new ArraySet<>();
+            sessionOwners.collectUserIds(userIds);
+            automatableApps.collectUserIds(userIds);
+            for (int i = 0; i < userIds.size(); i++) {
+                final int userId = userIds.valueAt(i);
+                serializer.startTag(null, TAG_USER);
+                serializer.attributeInt(null, ATTR_USER_ID, userId);
+                sessionOwners.writeUser(serializer, userId, TAG_SESSION_OWNER);
+                automatableApps.writeUser(serializer, userId, TAG_AUTOMATABLE_APP);
+                serializer.endTag(null, TAG_USER);
+            }
+            serializer.endTag(null, TAG_ROOT);
+            serializer.endDocument();
+            mAtomicFile.finishWrite(stream);
+        } catch (IOException e) {
+            Slog.e(TAG, "Failed to write user allowlist", e);
+            if (stream != null) {
+                mAtomicFile.failWrite(stream);
+            }
+        }
+    }
+
+    /** Digests of the certificates an entry for {@code signingDetails} is bound to. */
+    @NonNull
+    private static ArraySet<String> certificateDigests(@NonNull SigningDetails signingDetails) {
+        final ArraySet<String> digests = new ArraySet<>();
+        final Signature[] signatures = signingDetails.getSignatures();
+        if (signatures == null) {
+            return digests;
+        }
+        for (Signature signature : signatures) {
+            final String digest = PackageUtils.computeSha256Digest(signature.toByteArray());
+            if (digest != null) {
+                digests.add(digest);
+            }
+        }
+        return digests;
+    }
+
+    /** Per user, package name to the certificate digests it was allowed with. */
+    private static final class PackageList {
+        private final SparseArray<ArrayMap<String, ArraySet<String>>> mPackages =
+                new SparseArray<>();
+
+        boolean matches(@UserIdInt int userId, @NonNull String packageName,
+                @NonNull SigningDetails signingDetails) {
+            final ArrayMap<String, ArraySet<String>> packages = mPackages.get(userId);
+            final ArraySet<String> digests = packages == null ? null : packages.get(packageName);
+            return digests != null && signingDetails.hasAncestorOrSelfWithDigest(digests);
+        }
+
+        /** Returns whether the list changed. */
+        boolean add(@UserIdInt int userId, @NonNull String packageName,
+                @NonNull SigningDetails signingDetails) {
+            final ArraySet<String> digests = certificateDigests(signingDetails);
+            if (digests.isEmpty()) {
+                throw new IllegalArgumentException("No signing certificate for " + packageName);
+            }
+            final ArrayMap<String, ArraySet<String>> packages = mPackages.get(userId);
+            if (packages != null && digests.equals(packages.get(packageName))) {
+                return false;
+            }
+            put(userId, packageName, digests);
+            return true;
+        }
+
+        /** Returns whether the list changed. */
+        boolean remove(@UserIdInt int userId, @NonNull String packageName) {
+            final ArrayMap<String, ArraySet<String>> packages = mPackages.get(userId);
+            if (packages == null || packages.remove(packageName) == null) {
+                return false;
+            }
+            if (packages.isEmpty()) {
+                mPackages.remove(userId);
+            }
+            return true;
+        }
+
+        void put(@UserIdInt int userId, @NonNull String packageName,
+                @NonNull ArraySet<String> digests) {
+            ArrayMap<String, ArraySet<String>> packages = mPackages.get(userId);
+            if (packages == null) {
+                packages = new ArrayMap<>();
+                mPackages.put(userId, packages);
+            }
+            packages.put(packageName, digests);
+        }
+
+        void clear() {
+            mPackages.clear();
+        }
+
+        void replaceWith(@NonNull PackageList other) {
+            mPackages.clear();
+            for (int i = 0; i < other.mPackages.size(); i++) {
+                mPackages.put(other.mPackages.keyAt(i), other.mPackages.valueAt(i));
+            }
+        }
+
+        @NonNull
+        PackageList copy() {
+            final PackageList copy = new PackageList();
+            for (int i = 0; i < mPackages.size(); i++) {
+                final ArrayMap<String, ArraySet<String>> packages = new ArrayMap<>();
+                for (Map.Entry<String, ArraySet<String>> entry : mPackages.valueAt(i).entrySet()) {
+                    packages.put(entry.getKey(), new ArraySet<>(entry.getValue()));
+                }
+                copy.mPackages.put(mPackages.keyAt(i), packages);
+            }
+            return copy;
+        }
+
+        void collectUserIds(@NonNull ArraySet<Integer> userIds) {
+            for (int i = 0; i < mPackages.size(); i++) {
+                userIds.add(mPackages.keyAt(i));
+            }
+        }
+
+        void writeUser(@NonNull TypedXmlSerializer serializer, @UserIdInt int userId,
+                @NonNull String tag) throws IOException {
+            final ArrayMap<String, ArraySet<String>> packages = mPackages.get(userId);
+            if (packages == null) {
+                return;
+            }
+            for (int i = 0; i < packages.size(); i++) {
+                serializer.startTag(null, tag);
+                serializer.attribute(null, ATTR_PACKAGE, packages.keyAt(i));
+                final ArraySet<String> digests = packages.valueAt(i);
+                for (int j = 0; j < digests.size(); j++) {
+                    serializer.startTag(null, TAG_CERT);
+                    serializer.attribute(null, ATTR_SHA256, digests.valueAt(j));
+                    serializer.endTag(null, TAG_CERT);
+                }
+                serializer.endTag(null, tag);
+            }
+        }
+
+        @Override
+        public String toString() {
+            return mPackages.toString();
+        }
+    }
+}
