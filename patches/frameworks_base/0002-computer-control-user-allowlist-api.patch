+        @Override // Binder call
+        @EnforcePermission(android.Manifest.permission.MANAGE_COMPUTER_CONTROL_CONSENT)
+        public boolean isPackageApprovedToRunAutomationByUser(@NonNull String packageName,
+                @UserIdInt int userId) {
+            isPackageApprovedToRunAutomationByUser_enforcePermission();
+            Objects.requireNonNull(packageName);
+            if (!android.companion.virtualdevice.flags.Flags.computerControlAccess()) {
+                return false;
+            }
+            enforceCallerCanManageUser(userId);
+            return Binder.withCleanCallingIdentity(() ->
+                    mComputerControlSessionProcessor.isPackageApprovedToRunAutomationByUser(
+                            packageName, userId));
+        }
