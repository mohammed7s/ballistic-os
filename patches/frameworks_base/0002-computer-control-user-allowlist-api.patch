+    /**
+     * Returns whether the user approved the given package as a computer control agent.
+     */
+    public boolean isPackageApprovedToRunAutomationByUser(@NonNull String packageName,
+            @UserIdInt int userId) {
+        return mAllowlistController.isPackageApprovedToRunAutomationByUser(packageName, userId);
+    }
+
+    /**
+     * Sets whether the user approves the given package as a computer control agent. Withdrawing
+     * the approval closes the package's ongoing sessions.
+     */
+    public void setPackageApprovedToRunAutomationByUser(@NonNull String packageName,
+            @UserIdInt int userId, boolean approved) {
+        mAllowlistController.setPackageApprovedToRunAutomationByUser(packageName, userId,
+                approved);
+        if (approved) {
+            return;
+        }
+        synchronized (mSessions) {
+            for (int i = 0; i < mSessions.size(); i++) {
+                ComputerControlSessionImpl session = mSessions.valueAt(i);
+                if (session.getOwnerPackageName().equals(packageName)) {
+                    session.close(CLOSE_REASON_USER_INITIATED);
+                }
+            }
+        }
+    }
+
+    /**
+     * Returns whether the user allowed the given package to be automated.
+     */
+    public boolean isPackageTargetableForAutomationByUser(@NonNull String packageName,
+            @UserIdInt int userId) {
+        return mAllowlistController.isPackageTargetableForAutomationByUser(packageName, userId);
+    }
+
+    /**
+     * Sets whether the user allows the given package to be automated. Withdrawing it closes any
+     * ongoing session automating the package.
+     */
+    public void setPackageTargetableForAutomationByUser(@NonNull String packageName,
+            @UserIdInt int userId, boolean targetable) {
+        mAllowlistController.setPackageTargetableForAutomationByUser(packageName, userId,
+                targetable);
+        if (targetable) {
+            return;
+        }
+        synchronized (mSessions) {
+            for (int i = 0; i < mSessions.size(); i++) {
+                ComputerControlSessionImpl session = mSessions.valueAt(i);
+                if (session.isAutomatingPackage(packageName)) {
+                    session.close(CLOSE_REASON_USER_INITIATED);
+                }
+            }
+        }
+    }
+
