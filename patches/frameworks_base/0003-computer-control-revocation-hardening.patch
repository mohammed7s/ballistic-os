+    private static boolean isProtectedTarget(@Nullable String packageName) {
+        return "com.android.settings".equals(packageName)
+                || "com.android.virtualdevicemanager".equals(packageName);
+    }
+
+    /** Rechecks persisted gates using the request identity, not the handler's Binder identity. */
+    boolean isRequestStillAllowed(@NonNull ComputerControlSessionRequest request,
+            @NonNull List<String> approvedTargets) {
+        final String owner = request.ownerPackageName();
+        final PackageManager pm = request.ownerPackageManager();
+        if (getPackageUid(owner, pm) != request.ownerUid()
+                || (!isTestAgent(request.ownerUid(), owner, pm)
+                        && !isPackageApprovedToRunAutomation(owner, request.ownerUserId()))) {
+            return false;
+        }
+        for (String target : request.params().getTargetPackageNames()) {
+            if (!isPackageAutomatable(target, owner, pm)
+                    || (!approvedTargets.contains(target)
+                            && !doesAgentHaveConsentToAutomateTargetApp(
+                                    request.ownerUid(), owner, target))) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    private void clearConsentForTarget(@UserIdInt int userId, @NonNull String packageName) {
+        synchronized (mPerAgentAutomatableAppList) {
+            boolean changed = false;
+            for (int i = 0; i < mPerAgentAutomatableAppList.size(); i++) {
+                if (UserHandle.getUserId(mPerAgentAutomatableAppList.keyAt(i)) == userId) {
+                    for (Set<String> targets : mPerAgentAutomatableAppList.valueAt(i).values()) {
+                        changed |= targets.remove(packageName);
+                    }
+                }
+            }
+            if (changed) {
+                scheduleWritePerAgentConsentData();
+            }
+        }
+    }
+
+    @VisibleForTesting
+    void onUserRemoved(@UserIdInt int userId) {
+        mUserAllowlist.onUserRemoved(userId);
+        synchronized (mPerAgentAutomatableAppList) {
+            for (int i = mPerAgentAutomatableAppList.size() - 1; i >= 0; i--) {
+                if (UserHandle.getUserId(mPerAgentAutomatableAppList.keyAt(i)) == userId) {
+                    mPerAgentAutomatableAppList.removeAt(i);
+                }
+            }
+            scheduleWritePerAgentConsentData();
+        }
+    }
+
