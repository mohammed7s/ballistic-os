From d6c4a02884c031e0cb44cff740649f8b584265ba Mon Sep 17 00:00:00 2001
From: Mohammed <91819504+mohammed7s@users.noreply.github.com>
Date: Sat, 21 Nov 2026 14:07:55 +0300
Subject: [PATCH] roles: grant optional Computer Control access to the chosen
 assistant

Retain role qualification and requested-permission filtering. The optional grant applies only when the platform defines the role-protected permission; it does not select an assistant or enable owner gates.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 PermissionController/res/xml/roles.xml        |  3 +++
 .../mocking/role/model/RoleParserTest.kt      | 21 +++++++++++++++++++
 2 files changed, 24 insertions(+)

diff --git a/PermissionController/res/xml/roles.xml b/PermissionController/res/xml/roles.xml
index dadfd1b..784640e 100644
--- a/PermissionController/res/xml/roles.xml
+++ b/PermissionController/res/xml/roles.xml
@@ -149,6 +149,9 @@
             <permission-set name="sms" />
             <permission name="android.permission.READ_CALL_LOG" />
             <permission name="android.permission.ACCESS_BLOBS_ACROSS_USERS" minSdkVersion="31" />
+            <!-- Grant only when the platform defines the role-protected permission. -->
+            <permission name="android.permission.ACCESS_COMPUTER_CONTROL"
+                minSdkVersion="10000" optionalMinSdkVersion="37" />
             <permission name="android.permission.READ_ASSISTANT_APP_SEARCH_DATA"
                 minSdkVersion="33"/>
             <permission name="android.permission.SUBSCRIBE_TO_KEYGUARD_LOCKED_STATE"
diff --git a/PermissionController/tests/mocking/src/com/android/permissioncontroller/tests/mocking/role/model/RoleParserTest.kt b/PermissionController/tests/mocking/src/com/android/permissioncontroller/tests/mocking/role/model/RoleParserTest.kt
index 13c0435..3ec7b50 100644
--- a/PermissionController/tests/mocking/src/com/android/permissioncontroller/tests/mocking/role/model/RoleParserTest.kt
+++ b/PermissionController/tests/mocking/src/com/android/permissioncontroller/tests/mocking/role/model/RoleParserTest.kt
@@ -50,6 +50,27 @@ class RoleParserTest {
     private val targetContext = instrumentation.targetContext
     private val packageManager = targetContext.packageManager
 
+    @Test
+    fun assistantComputerControlPermissionIsOptionalAndRoleProtected() {
+        val roles = requireNotNull(RoleParser(targetContext).parseRolesXml()).second
+        val assistant = requireNotNull(roles["android.app.role.ASSISTANT"])
+        val permission =
+            assistant.permissions.single { it.name == "android.permission.ACCESS_COMPUTER_CONTROL" }
+        check(permission.minSdkVersion == 10000)
+        check(permission.optionalMinSdkVersion == 37)
+        // With the patched feature enabled, the manifest must preserve the privileged grant path.
+        val info =
+            try {
+                packageManager.getPermissionInfo(permission.name, 0)
+            } catch (_: PackageManager.NameNotFoundException) {
+                org.junit.Assume.assumeTrue("Computer Control is disabled on this product", false)
+                return
+            }
+        check(info.protection == PermissionInfo.PROTECTION_INTERNAL)
+        check(info.protectionFlags and PermissionInfo.PROTECTION_FLAG_ROLE != 0)
+        check(info.protectionFlags and PermissionInfo.PROTECTION_FLAG_PRIVILEGED != 0)
+    }
+
     @Test
     fun parseRoles() {
         // We may need to call privileged APIs to determine availability of things.
