+package com.android.settings.applications.specialaccess.screenautomation
+
+import android.Manifest
+import android.content.Intent
+import android.content.pm.ApplicationInfo
+import android.content.pm.PackageInfo
+import android.content.pm.PackageManager
+import androidx.test.ext.junit.runners.AndroidJUnit4
+import com.android.settings.spa.app.specialaccess.ScreenAutomationApp
+import com.android.settings.spa.app.specialaccess.isAutomationTargetCandidate
+import com.android.settings.spa.app.specialaccess.matchesAutomationSearch
+import com.google.common.truth.Truth.assertThat
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.mockito.kotlin.any
+import org.mockito.kotlin.mock
+import org.mockito.kotlin.whenever
+
+@RunWith(AndroidJUnit4::class)
+class ScreenAutomationPageTest {
+    private val pm: PackageManager = mock()
+    private val app =
+        ApplicationInfo().apply {
+            packageName = "test.notes"
+            enabled = true
+        }
+
+    @Test
+    fun searchMatchesLabelOrPackageIgnoringCaseAndWhitespace() {
+        val entry = ScreenAutomationApp(app, "My Notes")
+        assertThat(matchesAutomationSearch(entry, " NOTES ")).isTrue()
+        assertThat(matchesAutomationSearch(entry, "TEST.NOT")).isTrue()
+        assertThat(matchesAutomationSearch(entry, "")).isTrue()
+        assertThat(matchesAutomationSearch(entry, "calendar")).isFalse()
+    }
+
+    @Test
+    fun excludesPermissionEditorsAndAssistantCandidates() {
+        whenever(pm.permissionControllerPackageName).thenReturn("test.permissions")
+        whenever(pm.getLaunchIntentForPackage(any())).thenReturn(Intent())
+        whenever(pm.getPackageInfo("test.notes", PackageManager.GET_PERMISSIONS))
+            .thenReturn(PackageInfo())
+        assertThat(isAutomationTargetCandidate(pm, app)).isTrue()
+        for (name in
+            listOf(
+                "com.android.settings",
+                "com.android.virtualdevicemanager",
+                "test.permissions",
+            )) {
+            app.packageName = name
+            assertThat(isAutomationTargetCandidate(pm, app)).isFalse()
+        }
+        app.packageName = "test.notes"
+        whenever(pm.getPackageInfo("test.notes", PackageManager.GET_PERMISSIONS))
+            .thenReturn(
+                PackageInfo().apply {
+                    requestedPermissions = arrayOf(Manifest.permission.ACCESS_COMPUTER_CONTROL)
+                }
+            )
+        assertThat(isAutomationTargetCandidate(pm, app)).isFalse()
+    }
+
+    @Test
+    fun excludesDisabledAndNonLaunchableApps() {
+        app.enabled = false
+        assertThat(isAutomationTargetCandidate(pm, app)).isFalse()
+        app.enabled = true
+        assertThat(isAutomationTargetCandidate(pm, app)).isFalse()
+    }
+}
