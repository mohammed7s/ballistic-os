+package com.android.settings.spa.app.specialaccess
+
+import android.Manifest
+import android.app.AppOpsManager
+import android.app.role.OnRoleHoldersChangedListener
+import android.app.role.RoleManager
+import android.companion.virtual.VirtualDeviceManager
+import android.content.BroadcastReceiver
+import android.content.Context
+import android.content.Intent
+import android.content.IntentFilter
+import android.content.pm.ApplicationInfo
+import android.content.pm.PackageManager
+import android.os.UserHandle
+import android.provider.Settings
+import android.view.ViewTreeObserver
+import androidx.compose.foundation.layout.Column
+import androidx.compose.foundation.layout.fillMaxSize
+import androidx.compose.foundation.layout.fillMaxWidth
+import androidx.compose.foundation.layout.padding
+import androidx.compose.foundation.lazy.LazyColumn
+import androidx.compose.foundation.lazy.items
+import androidx.compose.material3.OutlinedTextField
+import androidx.compose.material3.Text
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.DisposableEffect
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.mutableIntStateOf
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.runtime.produceState
+import androidx.compose.runtime.remember
+import androidx.compose.runtime.setValue
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.platform.LocalContext
+import androidx.compose.ui.platform.LocalView
+import androidx.compose.ui.res.stringResource
+import com.android.settings.R
+import com.android.settingslib.spa.widget.preference.MainSwitchPreference
+import com.android.settingslib.spa.widget.preference.Preference
+import com.android.settingslib.spa.widget.preference.PreferenceModel
+import com.android.settingslib.spa.widget.preference.SwitchPreference
+import com.android.settingslib.spa.widget.preference.SwitchPreferenceModel
+import com.android.settingslib.spa.widget.scaffold.SettingsScaffold
+import com.android.settingslib.spa.widget.ui.Footer
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+
+internal data class ScreenAutomationApp(val app: ApplicationInfo, val label: String)
+
+internal fun matchesAutomationSearch(app: ScreenAutomationApp, query: String): Boolean =
+    app.label.contains(query.trim(), ignoreCase = true) ||
+        app.app.packageName.contains(query.trim(), ignoreCase = true)
+
+internal fun isAutomationTargetCandidate(pm: PackageManager, app: ApplicationInfo): Boolean =
+    app.enabled &&
+        app.packageName != "com.android.settings" &&
+        app.packageName != "com.android.virtualdevicemanager" &&
+        app.packageName != pm.permissionControllerPackageName &&
+        pm.getLaunchIntentForPackage(app.packageName) != null &&
+        pm.getPackageInfo(app.packageName, PackageManager.GET_PERMISSIONS)
+            .requestedPermissions
+            ?.contains(Manifest.permission.ACCESS_COMPUTER_CONTROL) != true
+
+/** One owner control surface; the separate system request dialog continues to own consent. */
+@Composable
+internal fun ScreenAutomationPage(userId: Int = UserHandle.myUserId()) {
+    val context = LocalContext.current
+    val user = remember(userId) { UserHandle.of(userId) }
+    val userContext = remember(context, user) { context.createContextAsUser(user, 0) }
+    val pm = userContext.packageManager
+    val roles = context.getSystemService(RoleManager::class.java)
+    var revision by remember { mutableIntStateOf(0) }
+    var query by remember { mutableStateOf("") }
+    val view = LocalView.current
+    DisposableEffect(userContext, view) {
+        val focus = ViewTreeObserver.OnWindowFocusChangeListener { if (it) revision++ }
+        val roleListener = OnRoleHoldersChangedListener { role, _ ->
+            if (role == RoleManager.ROLE_ASSISTANT) revision++
+        }
+        val packages =
+            object : BroadcastReceiver() {
+                override fun onReceive(context: Context, intent: Intent) {
+                    revision++
+                }
+            }
+        val filter =
+            IntentFilter(Intent.ACTION_PACKAGE_ADDED).apply {
+                addAction(Intent.ACTION_PACKAGE_REMOVED)
+                addAction(Intent.ACTION_PACKAGE_CHANGED)
+                addDataScheme("package")
+            }
+        view.viewTreeObserver.addOnWindowFocusChangeListener(focus)
+        roles?.addOnRoleHoldersChangedListenerAsUser(context.mainExecutor, roleListener, user)
+        userContext.registerReceiver(packages, filter)
+        onDispose {
+            view.viewTreeObserver.removeOnWindowFocusChangeListener(focus)
+            roles?.removeOnRoleHoldersChangedListenerAsUser(roleListener, user)
+            userContext.unregisterReceiver(packages)
+        }
+    }
+    val selected =
+        remember(revision, user) {
+            roles?.getRoleHoldersAsUser(RoleManager.ROLE_ASSISTANT, user)?.firstOrNull()?.let {
+                try {
+                    pm.getApplicationInfo(it, 0)
+                } catch (_: PackageManager.NameNotFoundException) {
+                    null
+                }
+            }
+        }
+    val apps by
+        produceState<List<ScreenAutomationApp>>(emptyList(), userContext, revision) {
+            value =
+                withContext(Dispatchers.IO) {
+                    pm.getInstalledApplications(0)
+                        .mapNotNull { app ->
+                            try {
+                                if (
+                                    isAutomationTargetCandidate(pm, app) &&
+                                        userContext
+                                            .getSystemService(VirtualDeviceManager::class.java)
+                                            ?.computerControlConsentManager
+                                            ?.isPackageEligibleForAutomation(
+                                                app.packageName,
+                                                userId,
+                                            ) == true
+                                ) {
+                                    ScreenAutomationApp(app, pm.getApplicationLabel(app).toString())
+                                } else null
+                            } catch (_: PackageManager.NameNotFoundException) {
+                                null
+                            }
+                        }
+                        .sortedBy { it.label.lowercase() }
+                }
+        }
+    SettingsScaffold(title = stringResource(R.string.computer_control_automation_page_title)) {
+        padding ->
+        Column(Modifier.padding(padding).fillMaxSize()) {
+            Preference(
+                object : PreferenceModel {
+                    override val title =
+                        stringResource(R.string.computer_control_selected_assistant)
+                    override val summary = {
+                        selected?.let {
+                            pm.getApplicationLabel(it).toString() + " (" + it.packageName + ")"
+                        } ?: context.getString(R.string.computer_control_choose_assistant)
+                    }
+                    override val onClick = {
+                        userContext.startActivity(
+                            Intent(Settings.ACTION_VOICE_INPUT_SETTINGS)
+                                .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
+                        )
+                    }
+                }
+            )
+            selected?.let { assistant ->
+                val controller =
+                    remember(assistant, revision) {
+                        ComputerControlConsentController(userContext, assistant)
+                    }
+                val eligible =
+                    pm.checkPermission(
+                        Manifest.permission.ACCESS_COMPUTER_CONTROL,
+                        assistant.packageName,
+                    ) == PackageManager.PERMISSION_GRANTED
+                MainSwitchPreference(
+                    object : SwitchPreferenceModel {
+                        override val title =
+                            stringResource(R.string.computer_control_automation_allow_agent)
+                        override val checked = { controller.isApprovedByUser }
+                        override val changeable = { eligible || controller.isApprovedByUser }
+                        override val onCheckedChange = { allowed: Boolean ->
+                            if (
+                                !allowed ||
+                                    (eligible &&
+                                        roles
+                                            ?.getRoleHoldersAsUser(RoleManager.ROLE_ASSISTANT, user)
+                                            ?.contains(assistant.packageName) == true)
+                            ) {
+                                controller.setApprovedByUser(allowed)
+                                if (
+                                    allowed &&
+                                        controller.appOpsMode != AppOpsManager.MODE_ALLOWED &&
+                                        controller.appOpsMode != AppOpsManager.MODE_DEFAULT
+                                ) {
+                                    controller.clearAutomatablePackages()
+                                    controller.setAppOpMode(AppOpsManager.MODE_DEFAULT)
+                                }
+                            }
+                            revision++
+                        }
+                    }
+                )
+                if (!eligible)
+                    Footer(stringResource(R.string.computer_control_assistant_unavailable))
+            }
+            OutlinedTextField(
+                value = query,
+                onValueChange = { query = it },
+                label = { Text(stringResource(R.string.computer_control_search_apps)) },
+                singleLine = true,
+                modifier = Modifier.fillMaxWidth(),
+            )
+            LazyColumn {
+                item { Footer(stringResource(R.string.computer_control_target_apps)) }
+                items(
+                    apps.filter { matchesAutomationSearch(it, query) },
+                    key = { it.app.packageName },
+                ) { entry ->
+                    val controller =
+                        remember(entry, revision) {
+                            ComputerControlConsentController(userContext, entry.app)
+                        }
+                    SwitchPreference(
+                        object : SwitchPreferenceModel {
+                            override val title = entry.label
+                            override val summary = { entry.app.packageName }
+                            override val checked = { controller.isTargetableByUser }
+                            override val onCheckedChange = { allowed: Boolean ->
+                                controller.setTargetableByUser(allowed)
+                                revision++
+                            }
+                        }
+                    )
+                }
+                item { Footer(stringResource(R.string.computer_control_central_footer)) }
+            }
+        }
+    }
+}
